{
  "type": "skill",
  "code": "matt-mainflow",
  "version": "1.0.1",
  "name": "Matt Pocock 开发工作流",
  "name_en": "Matt Pocock Mainflow",
  "description": "把 Matt Pocock 的六步开发工作流 The Main Flow（Skills 仓库获 30 万+ GitHub Stars）串成一个入口，给开发流程加上「自动挡」：你只管说要做什么，Agent 会根据实际任务和当前进度判断该走哪一步，并调用对应的 Skill，让这套工作流更容易上手。",
  "runtimeTargets": [
    "codex",
    "claude-code",
    "workbuddy",
    "zcode",
    "deepseek-harness",
    "opencode"
  ],
  "examplePrompts": [
    "用 Matt Pocock 开发工作流 推进登录跳转需求，先确认范围和验收条件。",
    "按已有规格推进实现和代码审查，先核对规格是否适用于当前任务。",
    "继续当前项目里暂停的任务，告诉我现在在哪一步。"
  ],
